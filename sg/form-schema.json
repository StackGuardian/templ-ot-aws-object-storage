    "advanced_settings": {
      "type": "object",
      "properties": {
        "show_advanced_settings": {
          "type": "boolean",
          "default": false
        }
      },
      "dependencies": {
        "show_advanced_settings": {
          "oneOf": [
            {
              "properties": {
                "show_advanced_settings": {
                  "enum": [
                    false
                  ]
                }
              },
              "required": []
            },
            {
              "properties": {
                "show_advanced_settings": {
                  "enum": [
                    true
                  ]
                },
                "versioning_enabled": {
                  "title": "Versioning enabled",
                  "type": "boolean",
                  "description": "Keep old versions of objects",
                  "default": true
                },
                "noncurrent_version_expiration_days": {
                  "title": "Old version expiration days",
                  "type": "number",
                  "description": "Days after which old versions are deleted (needs versioning)",
                  "default": 30,
                  "enum": [
                    1,
                    7,
                    14,
                    30,
                    60,
                    90,
                    180,
                    365
                  ],
                  "enumNames": [
                    "1 day",
                    "7 days",
                    "14 days",
                    "30 days",
                    "60 days",
                    "90 days",
                    "180 days",
                    "365 days"
                  ]
                },
                "kms_key_arn": {
                  "title": "KMS key ARN",
                  "type": "string",
                  "description": "ARN of a KMS key or alias for SSE-KMS on the data bucket. Empty means SSE-S3.",
                  "default": ""
                },
                "log_retention_days": {
                  "title": "Access log retention days",
                  "type": "number",
                  "description": "Days to keep server access logs",
                  "default": 90,
                  "enum": [
                    7,
                    14,
                    30,
                    60,
                    90,
                    180,
                    365,
                    730
                  ],
                  "enumNames": [
                    "7 days",
                    "14 days",
                    "30 days",
                    "60 days",
                    "90 days",
                    "180 days",
                    "365 days",
                    "730 days"
                  ]
                },
                "force_destroy": {
                  "title": "Force destroy",
                  "type": "boolean",
                  "description": "Delete all objects when the buckets are destroyed. Turn it off to protect the data.",
                  "default": true
                },
                "tags": {
                  "title": "Tags",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Additional tags for all resources",
                  "default": {}
                }
              },
              "required": []
            }
          ]
        }
      }
    }
